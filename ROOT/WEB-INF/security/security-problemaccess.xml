<?xml version="1.0" encoding="UTF-8"?>

<security xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../conf/security-sdp.xsd">



	<urls authentication="required">
		<throttles name="problem_other_edit" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true" >
			<throttle duration="1m" threshold="60" lock-period="5m"/>
		</throttles>
		<url path="/SendNotification.cc" roles="ModifyProblems" method="GET" operation-param="mode" operation-value="show">
			<param name="PROBLEMID" type="long" allow-empty="false" range=">0"/>
			<param name="to" regex="PR_NOT_GNRL_REQ|PR_NOT_GNRL_TECH|PR_GEN"  />
		</url>
		<url path="/SendNotification.cc"  method="post" csrf="true" roles="ModifyProblems" operation-param="mode" operation-value="Submit">
			<param name="UNIQUE_ID" regex="SendNotification" />
			<!--No emailstring regex as multiple to address can be sent -->
			<param name="TO" type="String" allow-empty="false" max-len="2000" secret="true"/>
			<param name="CC" type="String" max-len="2000" secret="true"/>
			<param name="SUBJECT" xss="sdpantisamyfilter" max-len="500" secret="true" />
			<!-- antisamyfilter added as max-len=-1 -->
			<param name="DESCRIPTION" xss="sdpantisamyfilter" max-len="-1" secret="true" />

			<param name="TYPE" regex="PR_NOT_GNRL_REQ|PR_NOT_GNRL_TECH|PR_GEN|null"  />
			<param name="PROBLEMID" min-occurrences="1" type="long"  range=">0" />
			<!-- Other language failing, hence type= String otherwise should have regex= Send -->
			<param name="SUBMIT" type="String"   />
		</url>


<!-- Problem New Client changes -->
		<url path="/ui/problems" method="get" roles="SDAdmin" operation-param="mode" operation-value="formpreview"/>
		<url path="/ui/problems" method="get" roles="CreateProblems" operation-param="mode" operation-value="add">
			<param name="associatedEntityId" type="long" range=">0"/>
			<param name="from" regex="request|cmdb" />
			<param name="operation" regex="associateto" />
			<param name="overwrite" type="long" range="1-3"/>
			<param name="templateId" type="long" range=">0"/>
		</url>
		<url path="/ui/problems" method="get" roles="ViewProblems" operation-param="mode" operation-value="detail">
			<param name="entity_id" type="long" range=">0"/>
			<param name="printPreview" type="boolean"/>
		</url>
		<url path="/ui/problems" method="get" roles="ModifyProblems" operation-param="mode" operation-value="edit">
			<param name="entity_id" type="long" range=">0"/>
			<param name="input_data" type="JSONObject" template="allowed_values_list_info"/>
		</url>

		<url path="/ui/problems" method="get" roles="ViewProblems" operation-param="mode" operation-value="list">
			<param name="TYPE" regex="my_pending_problems|unassigned_problems|my_open_problems"/>
			<param name="gsearch" type="String" max-len="5000" secret="true"/>
			<param name="from" regex="change|request|asset|services"/>
			<param name="fromActions" type="boolean"/>
			<param name="operation" regex="associated|associateto"/>
			<param name="associatedEntityId" type="long" range=">0"/>
			<param name="printPreview" type="boolean"/>
		</url>

 		<url path="/ui/print" roles="ViewProblems" method="get" operation-param="module" operation-value="problem">
            <param name="entity_id" type="long" range=">0" />
			<param name="previewSlider" type="boolean" />
			<param name="printMode" type="boolean"  max-occurrences="1"  />
        </url>

	  <url path="/common/ViewHistory.jsp" roles="ViewProblems" operation-param="module" operation-value="problems">
        <param name="id" type="long" range=">0" allow-empty="false"/>
		<!-- regex configured so secret true avoided-->
        <param name="key" regex="problem_history_sort_order"/>
        <param name="print_view" type="boolean"/>
        <param name="is_new_history" type="boolean"/>
      </url>

		<!-- Problem New Client changes -->

	<!-- Request Associations page start-->
	<url path="/workorder/RequestListViewWeb.jsp" method="get" roles="ViewRequests" operation-param="module" operation-value="problem">
        <param name="module_id" regex="id" />
            <param name="externalframe" type="boolean" />
            <param name="view" regex="associated|association" />
            <param name="type" regex="associated_incidents" />
        <param name="canAssociate" type="boolean" />
      </url>
    <!-- Request Associations page End -->

	</urls>
</security>

