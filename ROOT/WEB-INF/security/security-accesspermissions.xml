    <urls authentication="required" api="true">
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/request_notification_rules/(_?)history" method="get">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/request_notification_rules/(_?)get_records_for_history" method="get">
