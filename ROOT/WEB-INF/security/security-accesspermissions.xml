        </url>
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/request_notification_rules/(_?)get_performed_by_for_history" method="get">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/request_notification_rules/(_?)metainfo" method="get" >
             <param allow-invalid="false" name="input_data" template="metainfo" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/mobile_app_notification_rules/(_?)history" method="get" rebrand="zmon">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/mobile_app_notification_rules/(_?)get_records_for_history" method="get" rebrand="zmon">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/mobile_app_notification_rules/(_?)get_performed_by_for_history" method="get" rebrand="zmon">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDAdmin,HelpdeskConfig" path="/api/v3/mobile_app_notification_rules/(_?)metainfo" method="get" rebrand="zmon">
            <param allow-invalid="false" name="input_data" template="metainfo" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDOrgAdmin" path="/api/v3/esm_notification_rules/(_?)history" method="get"  user_type="all">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url roles="SDOrgAdmin" path="/api/v3/esm_notification_rules/(_?)get_records_for_history" method="get"  user_type="all">
