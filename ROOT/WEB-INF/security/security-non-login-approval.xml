			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="approval_level_get" method="get">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="approval_level_get" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_level_id" type="long"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="approval_approve" method="put" csrf="true">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="approval_approve_key" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="approvals_approve_reject" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="approval_reject" method="put" csrf="true">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="approval_reject_key" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="approvals_approve_reject" name="input_data"/>
		</url>

		<url user_type="all" method="get" path="/api/v3/approval_clarifications/(\d+)/created_by/(\d+)/images/(\d+)" description="ROLE_NOT_REQUIRED">
			<throttles name="approval_clarification_images" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true">
				<throttle duration="1m" threshold="50" lock-period="5m"/>
			</throttles>
	        <param regex="[a-z0-9]+" max-occurrences="1" max-len="500" name="key" secret="true"/>
	    </url>

	    <url user_type="all" method="get" path="/api/v3/requests/(\d+)/approval_levels/(\d+)/approvals/(\d+)/clarifications/(\d+)/replies/(\d+)/created_by/(\d+)/images/(\d+)" description="ROLE_NOT_REQUIRED">
			<throttles name="approval_clarification_replies_images" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true">
				<throttle duration="1m" threshold="50" lock-period="5m"/>
			</throttles>
	        <param regex="[a-z0-9]+" max-occurrences="1" max-len="500" name="key" secret="true"/>
	    </url>

	</urls>
</security>
