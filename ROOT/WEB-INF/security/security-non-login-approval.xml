			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param allow-invalid="false" min-occurrences="1" max-len="-1" type="JSONObject" template="approval_clarification" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_update" method="put" csrf="true">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_update" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_clarification_id" type="long" min-occurrences="1"/>
			<param allow-invalid="false" min-occurrences="1" max-len="-1" type="JSONObject" template="approval_clarification" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_reply" method="post" csrf="true">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_reply" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
