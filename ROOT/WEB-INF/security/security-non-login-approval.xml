			<param allow-invalid="false" max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_mark_as_resolved" method="put" csrf="true">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_mark_as_resolved" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_clarification_id" type="long" min-occurrences="1"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_mark_as_pending" method="put" csrf="true">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_mark_as_pending" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_clarification_id" type="long" min-occurrences="1"/>
		</url>

		<!-- approval urls -->
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="approval_get_all" method="get">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="approval_get_all" dynamic-throttle="true" >
