				<throttle duration="1m" threshold="50" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_level_id" type="long"/>
			<param name="approval_id" type="long"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_total_count" method="get" >
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_total_count_key" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_level_id" type="long"/>
			<param name="approval_id" type="long"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_get" method="get" >
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_get" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_level_id" type="long"/>
			<param name="approval_id" type="long"/>
			<param name="approval_clarification_id" type="long" min-occurrences="1"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_entity_get" method="get">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_entity_get" dynamic-throttle="true" >
				<throttle duration="1m" threshold="30" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_level_id" type="long"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_entity_total_count" method="get">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="clarification_entity_total_count_key" dynamic-throttle="true" >
				<throttle duration="1m" threshold="10" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param name="approval_level_id" type="long"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="get_approvers_having_clarifications" method="get">
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="get_approvers_having_clarifications" dynamic-throttle="true" >
				<throttle duration="1m" threshold="20" lock-period="5m"/>
			</throttles>
			<param name="module" regex="request" min-occurrences="1" />
			<param name="module_id" type="long" min-occurrences="1" />
			<param name="key" type="String" max-len="200" secret="true" min-occurrences="1"/>
			<param allow-invalid="false" max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
		</url>
		<url path="/servlets/ApprovalServlet" operation-param="operation" operation-value="clarification_add" method="post" csrf="true">
