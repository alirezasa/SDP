	<urls authentication="public" method="post" csrf="true" allowed_portals="it" remote_server="true">
		<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="software_get" dynamic-throttle="true" >
			<throttle lock-period="5m" threshold="80" duration="1m"/>
		</throttles>
		<param name="pageLength" type="long" range=">0" max-occurrences="2"/>
		<param name="loadingMsg" type="String" allow-empty="false" max-len="100" max-occurrences="2"/>
		<param name="rowcount" type="String" allow-empty="false" max-len="100" max-occurrences="2"/>

		<url path="/discoveryServlet/RemoteDataServlet" api="true" csrf="false" operation-param="operation" operation-value="PushData" remote_server="false" description="FGR_APPLIED:Roles handled in servlet level, It is a non-login url and used for the purpose of remote server, so api=true is added">
			<file name="file" max-size="512000" allowed-extensions="zip" content-type-name="zip" allow-empty="false">
				<filename regex="[0-9a-zA-Z()\[\]{}+_\-\;\#\^\.\$@\?\,\:\'\!\P{InBasicLatin}\s]+" max-len="1000" min-occurrences="1" description="Hostname may end with dot(.), so a filename can have dotdot(..)"/>
			</file>
			<param name="siteId" type="long" range=">0"/>
			<param name="apiKey" secret="true" type="String" allow-empty="false" max-len="500" />
			<param name="buildnumber" type="long" range=">0" min-occurrences="1"/>
			<param name="siteName" type="String" max-len="100"/>
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="RemoteDataServlet_PushData" dynamic-throttle="true" >
				<throttle duration="1m" threshold="3" lock-period="5m"/>
			</throttles>
			<request>
				<headers>
					<header name="apiKey" type="String" secret="true" max-len="500" />
				</headers>
			</request>
		</url>

		<url path="/discoveryServlet/RemoteDataServlet" api="true" csrf="false" operation-param="operation" operation-value="GetSites" remote_server="false" description="FGR_APPLIED:Roles handled in servlet level, It is a non-login url and used for the purpose of remote server, so api=true is added">
			<param name="username" secret="true" type="String" max-len="300"/>
			<param name="apiKey" secret="true" type="String" allow-empty="false" max-len="500" />
			<param name="logonDomainName" secret="true" type="String" max-len="300"/>
			<param name="buildnumber" type="long" range=">0" min-occurrences="1"/>
			<param name="DOMAIN_NAME" secret="true" type="String" max-len="100"/>
			<param name="test" type="boolean" />
			<request>
				<headers>
					<header name="apiKey" type="String" secret="true" max-len="500" />
				</headers>
			</request>
		</url>

		<url path="/discoveryServlet/RemoteDataServlet" api="true" csrf="false" operation-param="operation" operation-value="getSNMPCentralSyncData" remote_server="false" description="FGR_APPLIED:Roles handled in servlet level, It is a non-login url and used for the purpose of remote server, so api=true is added">
			<param name="username" secret="true" type="String" max-len="300"/>
			<param name="logonDomainName" secret="true" type="String" max-len="300"/>
			<param name="buildnumber" type="long" range=">0" min-occurrences="1"/>
			<param name="DOMAIN_NAME" secret="true" type="String" max-len="100"/>
		</url>
		
		<url path="/servlets/DCPluginServlet" operation-param="action" operation-value="syncServerInfo" api="true"  csrf="false" remote_server="true">
            <param name="apiKey" secret="true" type="String" max-len="100"/>
            <param name="serverName" secret="true" type="String" max-len="200"/>
            <param name="serverPort" secret="true" type="long" range=">0"/>
            <param name="serverProtocol" regex="http|https"/>
            <throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="DCPluginServlet" dynamic-throttle="true"  >
				<throttle duration="1m" threshold="20" lock-period="5m"/>
			</throttles>

			<!-- SD-111327 -->
			<request>
				<headers>
					<header name="apikey" type="String" secret="true" max-len="250" />
				</headers>
			</request>

		</url>		

		<url path="/discoveryServlet/WsDiscoveryServlet" api="true" csrf="false" description="Non-Login url called from Agent/script, so we cannot add roles">
			<param name="AGENT" type="String" secret="true" max-len="100"/>
			<param name="agent" type="String" secret="true" max-len="100"/>
			<!-- <param name="HANDSHAKE_KEY" secret="true" type="String" max-len="200"/> -->
			<param name="computerName" secret="true" type="String" max-len="200"/>
			<param name="COMPUTERNAME" secret="true" type="String" max-len="200"/>
			<param name="deviceName" secret="true" type="String" max-len="200"/>
			<param name="machineId" secret="true" type="String" max-len="200"/>
			<param name="siteName" type="String" max-len="200"/>
			<param name="accountName" type="String" secret="true" max-len="200"/>
			<param name="serviceTag" secret="true" type="String" max-len="200" />
			<param name="macAddress" secret="true" type="String" max-len="200" />
			<param name="agentId" secret="true" type="String" max-len="200"/>
			<param name="platform" type="String" max-len="200"/>
			<param name="UDID" secret="true" type="String" max-len="200"/>
			<inputstream type="String" max-len="-1" secret="true" description="since it is an input stream, max-len is configured as -1. xml data will be sent as stream from script scan."/>
			<throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="WsDiscoveryServlet" dynamic-throttle="true" >
				<throttle duration="1m" threshold="1000" lock-period="5m"/>
			</throttles>
		</url>
	</urls>

	<!-- JSON Templates -->
	<jsontemplates>
		<jsontemplate name="v3_domain_json" disable-extra-key="true">
