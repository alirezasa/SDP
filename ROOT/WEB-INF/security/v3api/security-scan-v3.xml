    </urls>

    <jsontemplates> 
        <jsontemplate name="domain_unique">
            <key name="id" type="long" range=">=0"/>
            <key name="name" secret="true" type="String" max-len="100"/>
            <key name="canonical_name" secret="true" type="String" max-len="100"/>
        </jsontemplate>

        <jsontemplate name="protocol_unique">
            <key name="id" type="long"/>
            <key name="name" type="String" secret="true" max-len="250"/>
        </jsontemplate>
        <!-- chassis_type starts -->
        <jsontemplate name="chassis_type_unique">
            <key name="id" type="long" range=">0"/>
            <key name="name" type="String" max-len="50"/>
            <key name="chassis_id" type="long" range=">0"/>
        </jsontemplate>
        <!-- chassis_type ends -->
        <!-- computer_group starts -->
        <jsontemplate name="computer_group_unique">
            <key name="id" type="long" range=">0"/>
            <key name="name" type="String" max-len="50"/>
        </jsontemplate>
        <!-- computer_group ends -->

        <jsontemplate name="discovery_type_constant_base">
            <key name="id" type="long" range=">0"/>
            <key name="name" type="String" max-len="250"/>
        </jsontemplate>

        <jsontemplate name="device_type_unique">
            <key name="id" type="long" range=">0"/>
            <key name="name" type="String" max-len="250"/>
        </jsontemplate>
        <!-- site_ip_mapping starts -->
        <jsontemplate name="site_ip_mapping_base">
            <key name="id" type="long" range=">0"/>
            <key name="site" template="site_unique" type="JSONObject" max-len="-1"/>
            <key name="ipaddress" secret="true" type="String" max-len="250"/>
            <key name="updated_by" template="technician_unique" type="JSONObject" max-len="-1"/>
        </jsontemplate>
        <jsontemplate name="site_ip_mapping">
            <key name="site_ip_mapping" template="site_ip_mapping_base" type="JSONObject" max-len="-1"/>
            <key name="site_ip_mappings" template="site_ip_mapping_base" type="JSONArray" max-len="-1" array-size="0-100"/>
        </jsontemplate>
        <!-- site_ip_mapping ends -->     
    </jsontemplates>
</security>