        </url>

        <url roles="SDAdmin" path="/api/v3/remote_controls/(_?)get_records_for_history" method="get">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>

        <url roles="SDAdmin" path="/api/v3/remote_controls/(_?)get_performed_by_for_history" method="get">
