<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<security xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../conf/security-sdp.xsd">
    <jsontemplates>
        <!-- list_info start -->
        <jsontemplate name="all_product_type_list_info">
            <key name="list_info" type="JSONObject" template="list_info_base" max-len="-1" />
            <key name="fields_required" type="JSONArray" array-size="0-100" template="strarray" max-len="-1" />
            <key name="for" regex="product" />
        </jsontemplate>
        <!-- list_info end -->
    </jsontemplates>
</security>
