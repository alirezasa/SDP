        <url path="/api/v3/portals/(\d+)/images" roles="SDAdmin,SDOrgAdmin" method="put" user_type="all">
            <throttles name="images" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true" >
                <throttle duration="1m" threshold="10" lock-period="5m"/>
            </throttles>
            <file name="input_image" max-size="3000" allow-empty="false" content-type-name="image_inline" allowed-extensions="gif,png,jpeg,jpg,bmp">
                <filename regex="filename" max-len="100"/>
            </file>
        </url>
	<url path="/api/v3/portals/images" roles="SDOrgAdmin" method="put" user_type="all">
		<throttles name="images" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true" >
			<throttle duration="1m" threshold="10" lock-period="5m"/>
		</throttles>
		<file name="input_image" max-size="3000" allow-empty="false" content-type-name="image_inline" allowed-extensions="gif,png,jpeg,jpg">
			<filename regex="filename" max-len="100"/>
		</file>
	</url>
       <url path="/api/v3/portals/(\d+)/images/(\d+)" roles="" method="get" user_type="all" description="ROLE_NOT_REQUIRED the url dynamically generated when getting the allowed portals for users. So no one can access not allowed portal images. Hence need no roles also becauseit is used by all users">
            <throttles name="images" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true" >
                <throttle duration="1m" threshold="30" lock-period="5m"/>
            </throttles>
            <param name="key" max-len="2000" regex="[a-z0-9]+" secret="true" max-occurrences="1"/>
            <param regex="50x50|120x120" name="res" max-occurrences="1" />
       </url>
