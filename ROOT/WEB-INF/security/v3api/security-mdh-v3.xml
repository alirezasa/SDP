<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<security xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../conf/security-sdp.xsd">
    <urls authentication="required" api="true" is_esm="true">
	<throttles name="mdh" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true" >
            <throttle duration="1m" threshold="30" lock-period="5m"/>
        </throttles>
	
	<url path="/api/v3/portals/(_?)history" method="get" roles="SDOrgAdmin,SDAdmin" user_type="all">
        <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
    </url>
   	<url path="/api/v3/portals/(_?)get_records_for_history" method="get" roles="SDOrgAdmin,SDAdmin" user_type="all">
    	<param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
    </url>
    <url path="/api/v3/portals/(_?)get_performed_by_for_history" method="get" roles="SDOrgAdmin,SDAdmin" user_type="all">
        <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
    </url>
	
	<url path="/api/v3/change_portal" user_type="all" method="put" api="true" description="ROLE_NOT_REQUIRED: Users can access this URL when they have access to multiple portals">
		<param name="portalid" type="long" range=">0" min-occurrences="1"/>
		<param name="current_tab" type="String" max-len="20"/>
	</url>
        <url path="/api/v3/accessibleportals" roles="Common_Role" method="get" user_type="all" description="ROLE_NOT_REQUIRED: This URL retrieves the portals that are accessible for the logged-in user">
