                <throttle duration="1m" threshold="30" lock-period="5m" />
            </throttles>
            <file allowed-extensions="gif,png,jpeg,jpg" content-type-name="image_inline" allow-empty="false" max-size="5120" name="input_image" remove-exif="true">
                <filename max-len="250" regex="filename"/>
            </file>
        </url>
        <url user_type="all" method="get" path="/api/v3/udf_fields/(\d+)/options/images/(\d+)" roles="" description="ROLE_NOT_REQUIRED : As image_token (key) will be used or Entity authorization will be invoked">
            <throttles window="ROLLING" scope="APPSERVER" key="url.path+url.dynamic_key" name="images_get" dynamic-throttle="true" >
                <throttle lock-period="5m" threshold="30" duration="1m"/>
            </throttles>
            <param name="res" regex="48x48|100x80|450x350" max-occurrences="1"/>
            <param name="key" regex="file_token" max-occurrences="1" max-len="500" secret="true"/>
        </url>
        <url user_type="all" method="get" path="/api/v3/udf_fields/(\d+)/options/(\d+)/images/(\d+)" roles="" description="ROLE_NOT_REQUIRED : As image_token (key) will be used or Entity authorization will be invoked">
