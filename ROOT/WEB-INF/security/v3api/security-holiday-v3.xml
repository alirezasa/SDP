<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<security xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../conf/security-sdp.xsd">
    <urls authentication="required" disable-extraparam="true" api="true">
        <throttles name="holiday" key="url.path+url.dynamic_key" scope="APPSERVER" window="ROLLING" dynamic-throttle="true" >
            <throttle duration="1m" threshold="30" lock-period="5m"/>
        </throttles>
        <url path="/api/v3/holidays/(_?)history" roles="SDAdmin" method="get">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url path="/api/v3/holidays/(_?)get_performed_by_for_history" roles="SDAdmin" method="get">
            <param allow-invalid="false" name="input_data" template="list_info" type="JSONObject" max-len="-1"/>
        </url>
        <url user_type="all" method="get" roles="" path="/api/v3/holidays" description="Server side authorization done">
            <param max-len="-1" type="JSONObject" template="list_info" name="input_data"/>
        </url>
    </urls>
</security>
